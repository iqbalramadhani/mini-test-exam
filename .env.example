# MINI Application Environment
# Copy this file to .env and fill in your values.

APP_ENV=development

DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_NAME=mini
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# SMTP Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# Google OAuth — get credentials from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated list of emails allowed to log in as admin
ADMIN_ALLOWED_EMAILS=admin@example.com

FRONTEND_URL=http://localhost:8000
